{
  "name": "@tche-agro/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "preinstall": "node scripts/check-node-version.mjs",
    "dev": "node --import=tsx src/server.ts",
    "dev:local": "node --env-file=.env.local --import=tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "test": "npm run test:unit && npm run test:http",
    "test:unit": "node --import=tsx --test \"tests/unit/*.test.ts\" \"tests/migrations/*.test.ts\"",
    "test:http": "node --import=tsx --test \"tests/http/*.test.ts\"",
    "pretest:integration": "npm run migrations:verify",
    "test:integration": "node --import=tsx --test \"tests/integration/*.test.ts\"",
    "migrations:verify": "node --import=tsx scripts/migration-integrity.ts verify",
    "migrations:verify-base": "node --import=tsx scripts/migration-integrity.ts verify-base",
    "migrate:up": "node --import=tsx scripts/migrate.ts up",
    "migrate:down": "node --import=tsx scripts/migrate.ts down",
    "migrate:redo": "node --import=tsx scripts/migrate.ts redo",
    "migrate:local:up": "node --env-file=.env.local --import=tsx scripts/migrate.ts up",
    "migrate:local:down": "node --env-file=.env.local --import=tsx scripts/migrate.ts down",
    "migrate:local:redo": "node --env-file=.env.local --import=tsx scripts/migrate.ts redo",
    "db:local:config": "docker compose --env-file .env.local config --quiet",
    "db:local:up": "docker compose --env-file .env.local up -d --wait",
    "db:local:down": "docker compose --env-file .env.local down",
    "db:local:logs": "docker compose --env-file .env.local logs -f postgres"
  },
  "dependencies": {
    "@fastify/swagger": "9.8.1",
    "env-schema": "8.0.0",
    "fastify": "5.12.0",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "cpu-features": false,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.5": true,
    "ssh2@1.17.0": true
  }
}
