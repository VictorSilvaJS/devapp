# Copie para .env.local e substitua todos os valores replace_* antes do uso.
POSTGRES_DB=replace_with_local_database_name
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

NODE_ENV=development
DATABASE_URL=postgresql://replace_with_local_database_user:replace_with_local_database_password@127.0.0.1:5432/replace_with_local_database_name
MIGRATIONS_DATABASE_URL=postgresql://replace_with_local_database_user:replace_with_local_database_password@127.0.0.1:5432/replace_with_local_database_name
OUTBOX_DATABASE_URL=postgresql://replace_with_local_database_user:replace_with_local_database_password@127.0.0.1:5432/replace_with_local_database_name
NOTIFICATIONS_MAINTENANCE_DATABASE_URL=postgresql://replace_with_local_database_user:replace_with_local_database_password@127.0.0.1:5432/replace_with_local_database_name
# Opcional: descomente somente com uma CA PEM valida para a credencial de purga.
# NOTIFICATIONS_MAINTENANCE_DATABASE_SSL_CA=replace_with_valid_pem_ca
PLATFORM_DATABASE_URL=postgresql://replace_with_local_database_user:replace_with_local_database_password@127.0.0.1:5432/replace_with_local_database_name
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Copie chaves locais de 32 bytes em base64. Gere valores próprios antes do uso.
AUTH_EMAIL_HMAC_KEY=replace_with_32_byte_base64_email_hmac_key
AUTH_IP_HMAC_KEY=replace_with_32_byte_base64_ip_hmac_key
AUTH_EXTERNAL_REFERENCE_HMAC_KEY=replace_with_32_byte_base64_external_reference_hmac_key
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_BLOCKLIST_MANIFEST_PATH=security/blocklists/passwords.manifest.json
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ARGON2_MAX_CONCURRENCY=2
AUTH_ACTION_BASE_URL=http://127.0.0.1:8081/auth-action
AUTH_RESTRICTED_AUTHORIZATION_TTL_SECONDS=900
ASSISTED_RECOVERY_ENABLED=true
ASSISTED_RECOVERY_POLICY_VERSION=local-development-v1
INITIAL_ADMIN_BOOTSTRAP_ENABLED=false

# Fixtures sintéticas: comando manual, nunca startup/migration. A URL dedicada
# deve apontar para banco terminado em _test ou _qa. Mantenha false por padrão.
ALLOW_QA_FIXTURES=false
QA_FIXTURES_DATABASE_URL=postgresql://replace_with_qa_database_user:replace_with_qa_database_password@127.0.0.1:5432/replace_with_database_qa
QA_FIXTURES_PASSWORD=

OUTBOX_ACTIVE_KEY_ID=local-v1
OUTBOX_ENCRYPTION_KEYS='{"local-v1":"replace_with_32_byte_base64_outbox_key"}'
OUTBOX_WORKER_ID=worker-local
OUTBOX_WORKER_CONCURRENCY=4
OUTBOX_WORKER_BATCH_SIZE=20
OUTBOX_WORKER_POLL_INTERVAL_MS=1000

# Purga one-shot de entregas e chaves de notificacao expiradas (1..5000).
NOTIFICATIONS_PURGE_BATCH_SIZE=1000

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_FROM="Tchê Agro <nao-responda@tche-agro.local>"
