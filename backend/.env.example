# Copie para .env.local e substitua todos os valores replace_* antes do uso.
POSTGRES_DB=replace_with_local_database_name
POSTGRES_USER=replace_with_local_database_user
POSTGRES_PASSWORD=replace_with_local_database_password
POSTGRES_PORT=5432

NODE_ENV=development
DATABASE_URL=postgresql://replace_with_local_database_user:replace_with_local_database_password@127.0.0.1:5432/replace_with_local_database_name
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
