{
  "name": "CadernoCampo",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "ID único do registro"
    },
    "produtor_id": {
      "type": "string",
      "description": "Alias legado aceito temporariamente na borda quando o valor representa a fazenda do registro"
    },
    "fazenda_id": {
      "type": "string",
      "description": "Campo canônico: ID da fazenda do registro"
    },
    "colaborador_responsavel": {
      "type": "string",
      "description": "Snapshot legível do nome do usuário responsável"
    },
    "responsavel_usuario_id": {
      "type": "string",
      "description": "ID estável do usuário responsável"
    },
    "data_atividade": {
      "type": "string",
      "format": "date-time",
      "description": "Data da atividade"
    },
    "tipo_atividade": {
      "type": "string",
      "enum": ["plantio", "adubacao", "aplicacao", "colheita", "analise_solo", "vistoria", "outro"],
      "description": "Tipo de atividade realizada"
    },
    "talhao": {
      "type": "string",
      "description": "Alias legado do nome do Talhão"
    },
    "talhao_id": {
      "type": "string",
      "description": "ID lógico e estável do Talhão"
    },
    "talhao_nome": {
      "type": "string",
      "description": "Snapshot legível do nome do Talhão"
    },
    "produtos_utilizados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Produtos utilizados na atividade"
    },
    "dosagem": {
      "type": "string",
      "description": "Dosagem dos produtos"
    },
    "area_aplicada": {
      "type": "number",
      "description": "Área em hectares onde foi aplicado"
    },
    "condicoes_clima": {
      "type": "string",
      "description": "Condições climáticas durante a atividade"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações gerais"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos"
    },
    "visivel_para_produtor": {
      "type": "boolean",
      "default": true,
      "description": "Se o registro é visível para o cliente"
    },
    "data_criacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data de criação do registro"
    },
    "criado_por_user_id": {
      "type": "string",
      "description": "ID do usuário que registrou o conteúdo, quando disponível"
    },
    "criado_por_nome": {
      "type": "string",
      "description": "Snapshot legível do nome do usuário que registrou o conteúdo"
    }
  },
  "required": ["colaborador_responsavel", "data_atividade", "tipo_atividade"],
  "anyOf": [
    { "required": ["fazenda_id"] },
    { "required": ["produtor_id"] }
  ]
}
