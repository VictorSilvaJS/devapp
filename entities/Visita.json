{
  "name": "Visita",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "ID único da visita"
    },
    "produtor_id": {
      "type": "string",
      "description": "Alias legado aceito temporariamente na borda quando o valor representa a fazenda atendida"
    },
    "fazenda_id": {
      "type": "string",
      "description": "Campo canônico: ID da fazenda atendida na visita"
    },
    "tecnico_responsavel": {
      "type": "string",
      "description": "Nome do técnico responsável"
    },
    "data_visita": {
      "type": "string",
      "format": "date-time",
      "description": "Data da visita"
    },
    "objetivo": {
      "type": "string",
      "enum": ["consultoria", "coleta_solo", "avaliacao_cultivo", "entrega_material", "outro"],
      "description": "Objetivo da visita"
    },
    "observacoes": {
      "type": "string",
      "description": "Observações da visita"
    },
    "recomendacoes": {
      "type": "string",
      "description": "Recomendações técnicas"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos tiradas na visita"
    },
    "clima": {
      "type": "string",
      "description": "Condições climáticas durante a visita"
    },
    "proximaVisita": {
      "type": "string",
      "format": "date",
      "description": "Data sugerida para próxima visita"
    },
    "status": {
      "type": "string",
      "enum": ["agendada", "realizada", "cancelada"],
      "default": "agendada",
      "description": "Status da visita"
    }
  },
  "required": ["tecnico_responsavel", "data_visita", "objetivo"],
  "anyOf": [
    { "required": ["fazenda_id"] },
    { "required": ["produtor_id"] }
  ]
}
