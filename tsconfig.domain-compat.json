{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "jsx": "react",
    "moduleResolution": "node",
    "outDir": ".tmp-domain-compat",
    "rootDir": ".",
    "esModuleInterop": true,
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "src/domain/**/*.ts",
    "src/api/validators.ts",
    "src/api/mockCompat.ts",
    "src/api/mock.ts"
  ]
}
